# .aiignore
# Excludes files from LLM context (GitHub Copilot, Claude, etc.)
# Pattern syntax mirrors .gitignore

# ─── Dependencies ────────────────────────────────────────────────────────────
# Massive, auto-generated — never useful as LLM context
node_modules/
**/node_modules/

# ─── Build & Compiled Output ─────────────────────────────────────────────────
dist/
build/
out/
.next/
**/dist/
**/build/

# ─── TypeScript Incremental Build Cache ──────────────────────────────────────
*.tsbuildinfo
**/*.tsbuildinfo

# ─── Environment & Secrets ───────────────────────────────────────────────────
# NEVER send credentials or secrets to any LLM
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
# Keep .env.example — it documents required vars without real values

# ─── Personal Notes ──────────────────────────────────────────────────────────
NOTES.md
!.env.example

# ─── Lock Files ──────────────────────────────────────────────────────────────
# Noisy, machine-generated, adds no value for code understanding
package-lock.json
yarn.lock
pnpm-lock.yaml
npm-shrinkwrap.json

# ─── Auto-Generated UI Components ────────────────────────────────────────────
# shadcn/ui primitives are scaffolded, not authored — exclude from context
# unless you are actively modifying them
client/src/components/ui/

# ─── Binary & Media Assets ───────────────────────────────────────────────────
# Binary files cannot be meaningfully read by LLMs
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.svg
*.woff
*.woff2
*.ttf
*.otf
*.eot
*.mp4
*.mp3
*.pdf

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Test Coverage & Reports ─────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── IDE & OS Metadata ───────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ─── Git Internals ───────────────────────────────────────────────────────────
.git/

# ─── Vite / Rollup Cache ─────────────────────────────────────────────────────
.vite/
**/.vite/

# ─── Miscellaneous ───────────────────────────────────────────────────────────
*.map
*.min.js
*.min.css
